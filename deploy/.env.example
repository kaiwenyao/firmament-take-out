# ============================================================
# firmament 部署环境变量示例
# 复制为 .env 后按需修改，.env 已被 .gitignore 排除，切勿提交真实密码
# ============================================================

# MySQL root 密码（容器首次初始化时生效）
# 后端容器也使用该密码以 root 连接（FIRMAMENT_DATASOURCE_PASSWORD 与其保持一致）
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# 首次初始化时创建的数据库（与后端 application-prod.yml 对应，勿随意改名）
MYSQL_DATABASE=firmament_take_out